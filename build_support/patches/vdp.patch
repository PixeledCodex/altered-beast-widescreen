+/* DMA completion updates the low source word even for fill. The 16-bit
+ * length encoding naturally makes zero/65536 wrap the source word unchanged. */
+static void dma_finish_registers(GVDP *v)
+{
+    uint16_t end = (uint16_t)(v->reg[21] + ((unsigned)v->reg[22] << 8)
+                           + v->reg[19] + ((unsigned)v->reg[20] << 8));
+    v->reg[21] = (uint8_t)end; v->reg[22] = (uint8_t)(end >> 8);
+    v->reg[19] = v->reg[20] = 0;
+}
